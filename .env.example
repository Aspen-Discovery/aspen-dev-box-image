# Aspen Dev Box - Environment Configuration
# Copy to .env and customise as needed

# Site
SITE_NAME=dev.localhost
URL=http://localhost:8083
TITLE=Aspen Discovery Dev
LIBRARY=Test Library
TIMEZONE=Europe/London
ASPEN_ADMIN_PASSWORD=password
SUPPORTING_COMPANY=DEV MACHINE

# Database (also configures the aspen-db service, phpMyAdmin and the Koha OAuth setup)
DATABASE_HOST=aspen-db
DATABASE_PORT=3306
DATABASE_NAME=aspen
DATABASE_USER=aspensuper
DATABASE_PASSWORD=aspensuper
DATABASE_ROOT_PASSWORD=aspen

# Solr (must match solr service below)
SOLR_HOST=solr
SOLR_PORT=8084

# Images (defaults: aspendiscovery/aspen:latest; solr major version detected from
# the checkout's luceneMatchVersion, configsets from data_dir_setup/solr*)
#ASPEN_IMAGE=aspendiscovery/aspen:latest
#SOLR_IMAGE=solr:9
#SOLR_CONFIGSETS=$ASPEN_CLONE/data_dir_setup/solr7

# Host port bindings (override to run several stacks side by side, or use the
# proxy overlay which drops host ports entirely)
#ASPEN_PORT=8083
#SOLR_HOST_PORT=8084
#DBGUI_PORT=8085
#JAVA_DEBUG_PORT=5005

# PHP-FPM (internal to the aspen container)
PHP_FPM_HOST=127.0.0.1
PHP_FPM_PORT=9000

# Plugins (host path to a dir of plugin checkouts, mounted at /plugins)
# Default: $ASPEN_DOCKER/plugins (empty unless you put plugins there)
#ASPEN_PLUGINS=/Users/you/workdir/aspen-plugins

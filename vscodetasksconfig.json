{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Debug Script",
      "type": "shell",
      "command": "adb debug ${input:projectArg}",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling .* for debugging",
          "endsPattern": "Waiting for a debugger to attach"
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "projectArg",
      "type": "promptString",
      "description": "Module under code/ to debug (adb debug list shows them). Default: koha_export",
      "default": "koha_export"
    }
  ]
}
